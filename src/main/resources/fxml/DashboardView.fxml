<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.Cursor?>

<BorderPane fx:id="rootPane" prefHeight="768.0" prefWidth="1366.0" stylesheets="@../css/dark-neon-theme.css" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.DashboardController">

    <left>
        <VBox fx:id="sideBar" prefHeight="768.0" prefWidth="280.0" spacing="20.0" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <VBox fx:id="logoContainer" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="KMS" textFill="#38bdf8" style="-fx-font-size: 24px; -fx-font-weight: 900;" />
                            </children>
                        </VBox>
                        <Button fx:id="btnHamburger" text="☰" mnemonicParsing="false" styleClass="btn-hamburger">
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </HBox>

                <HBox fx:id="profileCard" alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0f172a; -fx-background-radius: 12; -fx-padding: 12;">
                    <children>
                        <Circle fill="#38bdf8" radius="18.0" />
                        <VBox fx:id="profileInfo" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Admin" textFill="#f8fafc" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                                <Label text="Online" textFill="#22c55e" style="-fx-font-size: 10px;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Region prefHeight="20.0" />

                <VBox spacing="10.0">
                    <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" prefHeight="45.0" prefWidth="240.0" styleClass="btn-neon" text="Dashboard">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>

                        <Button fx:id="btnDataPutusan" mnemonicParsing="false" prefHeight="45.0" prefWidth="240.0" styleClass="btn-menu-flat" text="Data Putusan">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnLogout" mnemonicParsing="false" prefHeight="45.0" prefWidth="240.0" styleClass="btn-logout" text="Logout">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="30.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Dashboard Overview" textFill="#f8fafc" style="-fx-font-size: 32px; -fx-font-weight: bold;" />
                        <Label text="Analisis data putusan hukum narkotika terbaru." textFill="#94a3b8" style="-fx-font-size: 14px;" />
                    </children>
                </VBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox styleClass="card-stat" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Total Arsip" textFill="#94a3b8" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label text="1,248" textFill="#f8fafc" style="-fx-font-size: 28px; -fx-font-weight: 900;" />
                            </children>
                        </VBox>
                        <VBox styleClass="card-stat-active" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Kasus Aktif" textFill="#38bdf8" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label text="856" textFill="#f8fafc" style="-fx-font-size: 28px; -fx-font-weight: 900;" />
                            </children>
                        </VBox>
                        <VBox styleClass="card-stat" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="PDF Ekstrak" textFill="#94a3b8" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                                <Label text="24" textFill="#22c55e" style="-fx-font-size: 28px; -fx-font-weight: 900;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label text="Data Putusan Terbaru" textFill="#f8fafc" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtSearch" prefWidth="250.0" promptText="Cari data..." styleClass="search-field" />
                                <Button styleClass="btn-neon" text="+ Tambah Data" />
                            </children>
                        </HBox>

                        <TableView fx:id="tablePutusan" prefHeight="350.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNoPutusan" prefWidth="150.0" text="No. Putusan" />
                                <TableColumn fx:id="colTanggal" prefWidth="120.0" text="Tanggal" />
                                <TableColumn fx:id="colTerdakwa" prefWidth="200.0" text="Terdakwa" />
                                <TableColumn fx:id="colKlasifikasi" prefWidth="150.0" text="Klasifikasi" />
                                <TableColumn fx:id="colAksi" prefWidth="100.0" text="Aksi" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>