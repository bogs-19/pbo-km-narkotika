<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.Cursor?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@../css/dark-neon-theme.css" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.DashboardController">

    <left>
        <VBox prefHeight="768.0" prefWidth="280.0" spacing="20.0" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="25.0" right="25.0" top="40.0" />
            </padding>
            <children>

                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label text="KMS" textFill="#38bdf8" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-letter-spacing: 2px;" />
                        <Label text="PUTUSAN NARKOTIKA" textFill="#94a3b8" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0f172a; -fx-background-radius: 12; -fx-padding: 15;">
                    <children>
                        <Circle fill="#38bdf8" radius="20.0" />
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <children>
                                <Label text="Administrator" textFill="#f8fafc" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                    <children>
                                        <Circle fill="#22c55e" radius="4.0" />
                                        <Label text="Online" textFill="#22c55e" style="-fx-font-size: 11px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </HBox>

                <Label text="MAIN MENU" textFill="#64748b" style="-fx-font-size: 12px; -fx-font-weight: bold;" />

                <VBox spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="230.0" styleClass="btn-neon" text="Dashboard Overview">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>

                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="230.0" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT; -fx-padding: 0 0 0 20;" text="Data Putusan">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="230.0" style="-fx-background-color: #450a0a; -fx-text-fill: #f87171; -fx-border-color: #ef4444; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px;" text="Logout Sistem">
                    <cursor><Cursor fx:constant="HAND"/></cursor>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="30.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Dashboard Overview" textFill="#f8fafc" style="-fx-font-size: 32px; -fx-font-weight: bold;" />
                        <Label text="Ringkasan ekstraksi arsip putusan pengadilan narkotika." textFill="#94a3b8" style="-fx-font-size: 14px;" />
                    </children>
                </VBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox prefHeight="110.0" style="-fx-background-color: #1e293b; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Total Arsip Putusan" textFill="#94a3b8" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                                <Label text="1,248" textFill="#f8fafc" style="-fx-font-size: 32px; -fx-font-weight: 900;" />
                            </children>
                        </VBox>
                        <VBox prefHeight="110.0" style="-fx-background-color: #1e293b; -fx-background-radius: 12; -fx-border-color: #38bdf8; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Kasus Narkotika" textFill="#38bdf8" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                                <Label text="856" textFill="#f8fafc" style="-fx-font-size: 32px; -fx-font-weight: 900;" />
                            </children>
                        </VBox>
                        <VBox prefHeight="110.0" style="-fx-background-color: #1e293b; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Ekstraksi PDF Berhasil" textFill="#94a3b8" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                                <Label text="24" textFill="#22c55e" style="-fx-font-size: 32px; -fx-font-weight: 900;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Data Putusan Terbaru" textFill="#f8fafc" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" styleClass="btn-neon" style="-fx-font-size: 13px; -fx-padding: 8 20 8 20;" text="+ Tambah Arsip PDF">
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </Button>
                            </children>
                        </HBox>

                        <TableView fx:id="tablePutusan" prefHeight="350.0" prefWidth="800.0" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNoPutusan" prefWidth="180.0" text="No. Putusan" />
                                <TableColumn fx:id="colTanggal" prefWidth="120.0" text="Tanggal" />
                                <TableColumn fx:id="colTerdakwa" prefWidth="250.0" text="Nama Terdakwa" />
                                <TableColumn fx:id="colKlasifikasi" prefWidth="150.0" text="Klasifikasi" />
                                <TableColumn fx:id="colAksi" prefWidth="100.0" text="Aksi" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

</BorderPane>